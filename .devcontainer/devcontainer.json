{
    "name": "GAL Development Environment",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "runArgs": [
    "--name", "formais-dev"
    ],
    "remoteUser": "developer",
    "workspaceFolder": "/workspace",
    "postCreateCommand": "python -m pip install -e '.[dev]'",
    "customizations": {
        "jetbrains": {
            "backend": "PyCharm"
        }
    }
}

